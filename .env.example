# ---------------------------------------------------------------
# CASE SUNO backend — copy to .env for local development.
# On Render these are set in the dashboard (see render.yaml).
# ---------------------------------------------------------------

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Public website (used in e-mails / tracking links)
SITE_URL=http://localhost:3000

# Shared secret between the website server (Next.js) and this API.
# Use the SAME value in the frontend's WEBSITE_API_KEY. Leave empty only for local dev.
WEBSITE_API_KEY=

# Database: either one URL (Render) ...
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/case_suno_db
# ... or individual values
DB_NAME=case_suno_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# First admin login (python manage.py ensure_admin --if-configured)
ADMIN_EMAIL=admin@casesuno.in
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=CASE SUNO Admin
# Optional: who gets an e-mail on new enquiries / client replies (comma separated)
ADMIN_NOTIFY_EMAILS=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS / CSRF (only needed for direct browser calls and the Django admin)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://casesuno.in,https://www.casesuno.in
CSRF_TRUSTED_ORIGINS=https://casesuno.in,https://www.casesuno.in

# Email: console backend prints e-mails to the terminal.
# For real delivery (e.g. Hostinger mailbox):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.hostinger.com  EMAIL_PORT=465  EMAIL_USE_SSL=True  EMAIL_USE_TLS=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CASE SUNO <no-reply@casesuno.in>

# ---- Optional services (leave empty to disable) ----
# Redis cache + Celery worker (without them: in-memory cache, tasks run inline)
DJANGO_CACHE_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Private S3-compatible document storage
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=us-east-1

# ClamAV antivirus service
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Sentry error monitoring
SENTRY_DSN=
